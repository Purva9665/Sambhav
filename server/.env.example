# ============================================================================
# SAMBHAV Portal — backend environment
# Copy to .env for local development. On Render, set these under
# Service → Environment. Never commit the real .env.
# ============================================================================

# --- Required ---------------------------------------------------------------

# MongoDB Atlas connection string.
# Atlas → Network Access must allow 0.0.0.0/0 for Render (its IPs are dynamic).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/sambhav?retryWrites=true&w=majority

# Signing key for session tokens. Minimum 32 characters; the server refuses to
# start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# --- Strongly recommended ---------------------------------------------------

# Where registration verification codes are sent.
ADMIN_EMAIL=you@example.com

# Comma-separated list of front-end origins allowed to call this API.
# Must include your deployed static site. No trailing slashes.
CORS_ORIGINS=https://sambhav-portal.onrender.com,http://localhost:3000

NODE_ENV=production
PORT=5000

# --- Email (SendGrid) -------------------------------------------------------

# API key from SendGrid → Settings → API Keys (needs "Mail Send" permission).
SENDGRID_API_KEY=

# The address emails are sent FROM. This must be verified in SendGrid under
# Settings → Sender Authentication → Single Sender Verification, or every send
# fails with 403. It may differ from ADMIN_EMAIL.
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=SAMBHAV Portal

# --- First-run only ---------------------------------------------------------

# Used ONCE to create the first administrator, and only when the database has
# no admin at all. Minimum 12 characters.
# Sign in, change the password, then DELETE this variable and redeploy.
ADMIN_INITIAL_PASSWORD=
ADMIN_NAME=Portal Administrator

# --- Optional ---------------------------------------------------------------

# IANA timezone used to decide what "today" means for attendance sessions.
PORTAL_TIMEZONE=Asia/Kolkata

# Session lifetime (zeit/ms format).
JWT_EXPIRES_IN=8h
