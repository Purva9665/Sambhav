# ============================================================================
# SAMBHAV Portal — frontend environment
# On Render, set this under Static Site → Environment.
# Vite inlines VITE_* variables at BUILD time, so changing this requires a
# rebuild, not just a restart.
# ============================================================================

# Base URL of the backend web service. No trailing slash, no /api/v1 suffix —
# the client appends that itself.
VITE_API_URL=https://sambhav-api.onrender.com
